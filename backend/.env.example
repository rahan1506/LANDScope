# ==============================================================================
# LANDScope Sovereign Spatial Intelligence — Environment Configuration
# Copy this file to .env and configure credentials.
# In DEMO_MODE=true, the entire application runs with zero external keys.
# ==============================================================================

# 1. CORE SERVER & RUNTIME
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:3000

# 2. SECURITY & AUTHENTICATION
JWT_SECRET=sovereign_landscope_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# 3. DATABASE (POSTGRESQL + POSTGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landscope_gov
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=landscope_gov

# 4. BASE MAP PROVIDER
# Supported: openstreetmap, maplibre, maptiler, leaflet
MAP_PROVIDER=openstreetmap
MAP_API_KEY=your-maptiler-or-mapbox-key-if-commercial

# 5. EARTH OBSERVATION / SATELLITE PROVIDER
# Supported: demo, copernicus, usgs, nasa
SATELLITE_PROVIDER=demo
COPERNICUS_CLIENT_ID=your-copernicus-cdse-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-cdse-client-secret
USGS_API_KEY=your-usgs-earthexplorer-key

# 6. LLM & STATUTORY LEGAL AI PROVIDER
# Supported: demo, openai, gemini, ollama
LLM_PROVIDER=demo
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-2.5-flash

# 7. VECTOR DATABASE / RAG RETRIEVAL
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your-vector-db-api-key

# 8. FILE STORAGE ABSTRACTION
# Supported: local, s3, minio
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=landscope-evidence-vault
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your-s3-access-key
STORAGE_SECRET_KEY=your-s3-secret-key

# 9. RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# 10. NATIONAL ULPIN GATEWAY
ULPIN_GATEWAY_URL=https://dolr.gov.in/api/ulpin/v1
ULPIN_GATEWAY_TOKEN=your-national-cadastral-gateway-token
