# LANDScope Sovereign Spatial Intelligence Platform — Environment Configuration
# Copy this file to .env.local and populate with your credentials.

# ------------------------------------------------------------------------------
# 1. Base Map Provider (MapTiler Cloud)
# ------------------------------------------------------------------------------
# Get your free key from https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY_HERE

# ------------------------------------------------------------------------------
# 2. Supabase Backend (PostgreSQL + PostGIS + Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# ------------------------------------------------------------------------------
# 3. Earth Observation & Satellite APIs (Copernicus / Sentinel Hub)
# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) / Sentinel-2 L2A API
COPERNICUS_CLIENT_ID=your-copernicus-cdse-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-cdse-client-secret

# ISRO Bhuvan Open Cadastral WMS Services (Optional)
BHUVAN_API_KEY=your-isro-bhuvan-api-token

# ------------------------------------------------------------------------------
# 4. National Land Governance State Endpoints
# ------------------------------------------------------------------------------
# ULPIN / Bhu-Aadhaar National Portal Integration
ULPIN_GATEWAY_URL=https://dolr.gov.in/api/ulpin/v1
ULPIN_GATEWAY_TOKEN=your-national-cadastral-gateway-token
